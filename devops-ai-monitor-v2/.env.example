OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
LOG_TAIL_DEFAULT=150
REMEDIATION_DISABLED=true
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
API_KEY=
KUBERNETES_ENABLED=false
AWS_ENABLED=false
# Optional OpenTelemetry profile
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=devops-ai-monitor-api
OTEL_DEPLOYMENT_ENVIRONMENT=local
OTEL_SEMCONV_STABILITY_OPT_IN=http

# Change before starting the local telemetry profile
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local
